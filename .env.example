# GitHub App (Settings > Developer settings > GitHub Apps): its numeric id. The private key and the webhook secret go in
# secrets/github-app.pem and secrets/webhook-secret.
GITHUB_APP_ID=
# The model provider's key, passed to sleipnir and nothing else (REVIEWER_PASS_ENV names what is passed).
HEIMDALLM_API_KEY=
REVIEWER_PASS_ENV=HEIMDALLM_API_KEY

# How reviews run
REVIEWER_TEAM=8
REVIEWER_DEPTH=standard
REVIEWER_BUDGET_USD=4
REVIEWER_TIMEOUT=90m
REVIEWER_WORKERS=1
REVIEWER_MODEL=heimdallm/meta-models/muse-spark-open-816b-a42b
# role=model, comma separated
REVIEWER_ROLE_MODELS=architect=heimdallm/minimax/minimax-m3,scout=heimdallm/z-ai/glm-5.3-flash,backend=heimdallm/deepseek/deepseek-v4.1-flash,frontend=heimdallm/xiaomi/mimo-v2.6-flash-rl,tester=heimdallm/minimax/minimax-m3,reviewer=heimdallm/deepseek/deepseek-v4.1-flash
# The name comments use: "@reviewer review"
REVIEWER_BOT=reviewer
